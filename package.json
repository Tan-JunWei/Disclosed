    "@types/node": "^22.1.0",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/three": "0.187.0",
    "@types/ws": "^8.5.12",
    "@types/yargs": "^17.0.32",
    "esbuild": "^0.19.9",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
