{
  "name": "disclosed",
  "description": "Disclosed: CTF writeups and vulnerability research, built with Quartz",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "author": "Jun Wei Tan",
  "license": "MIT",
  "homepage": "https://disclosed.nepz.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tan-JunWei/Disclosed.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "start": "npm run quartz -- build --serve --port 3201 --wsPort 3202",
    "build": "(test \"$(git rev-parse --is-shallow-repository 2>/dev/null)\" != true || git fetch --unshallow --quiet) && npm run quartz -- build",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test \"quartz/**/*.test.ts\""
  },
  "engines": {
    "npm": ">=9.3.1",
    "node": "20 || >=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@floating-ui/dom": "^1.6.8",
    "@napi-rs/simple-git": "0.1.16",
    "async-mutex": "^0.5.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "cli-spinner": "^0.2.10",
    "d3": "^7.9.0",
    "esbuild-sass-plugin": "^2.16.1",
    "flexsearch": "0.7.43",
    "github-slugger": "^2.0.0",
    "globby": "^14.0.2",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.1",
    "hast-util-to-jsx-runtime": "^2.3.0",
    "hast-util-to-string": "^3.0.0",
    "is-absolute-url": "^4.0.1",
    "js-yaml": "^4.1.0",
    "lightningcss": "^1.25.1",
    "mdast-util-find-and-replace": "^3.0.1",
    "mdast-util-to-hast": "^13.2.0",
    "mdast-util-to-string": "^4.0.0",
    "micromorph": "^0.4.5",
    "preact": "^10.23.2",
    "preact-render-to-string": "^6.6.3",
    "pretty-bytes": "^6.1.1",
    "pretty-time": "^1.1.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-mathjax": "^6.0.0",
    "rehype-pretty-code": "^0.13.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "remark-smartypants": "^3.0.2",
    "rfdc": "^1.4.1",
    "rimraf": "^6.0.1",
    "serve-handler": "^6.1.5",
    "shiki": "^1.10.3",
    "source-map-support": "^0.5.21",
    "three": "0.187.0",
    "to-vfile": "^8.0.0",
    "toml": "^3.0.0",
    "unified": "^11.0.4",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.2",
